{
  "name": "@firfi/huly-cli",
  "version": "0.53.1-next.0",
  "description": "Feature-complete CLI for self-hosted Huly project management, issue tracking, automation, CI, and AI agents with 500+ native commands",
  "type": "module",
  "main": "./dist/index.cjs",
  "files": [
    "dist/index.cjs",
    "skills"
  ],
  "bin": {
    "huly": "./dist/index.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dearlordylord/huly-mcp.git",
    "directory": "packages/huly-cli"
  },
  "bugs": {
    "url": "https://github.com/dearlordylord/huly-mcp/issues"
  },
  "homepage": "https://huly-mcp.dearlordylord.com/cli/",
  "scripts": {
    "build": "PKG_VERSION=$(node -p \"require('./package.json').version\") && esbuild src/index.ts --bundle --platform=node --format=cjs --minify-whitespace --log-level=warning --outfile=dist/index.cjs --external:ws --external:@napi-rs/keyring --external:dbus-next \"--define:PKG_VERSION=\\\"$PKG_VERSION\\\"\"",
    "verify-version": "node -e \"const v=require('./package.json').version; const d=require('fs').readFileSync('dist/index.cjs','utf8'); if(!d.includes('\\\"'+v+'\\\"'))throw new Error('dist version mismatch: expected '+v)\"",
    "prepack": "pnpm build && pnpm verify-version",
    "prepublishOnly": "pnpm --dir ../.. check-all && pnpm build && pnpm verify-version"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1",
    "dbus-next": "0.10.2",
    "ws": "^8.18.0"
  },
  "keywords": [
    "huly",
    "huly-cli",
    "cli",
    "command-line",
    "command-line-interface",
    "terminal",
    "scripting",
    "automation",
    "self-hosted",
    "ai-agent",
    "ci-cd",
    "project-management",
    "issue-tracker",
    "task-management",
    "time-tracking",
    "document-management",
    "calendar",
    "developer-tools",
    "coding-agents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "author": "dearlordylord",
  "license": "MIT"
}
